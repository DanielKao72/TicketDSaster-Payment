PORT=3000

# development, test or production. Picks the database defaults; seeds never run in production.
# docker-compose forces development; the Docker image defaults to production.
APP_ENV=development

# Payment Store (PostgreSQL). docker-compose builds DATABASE_URL from these for its containers.
POSTGRES_USER=payment
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payment_store
POSTGRES_PORT=5432

# Used when running the service or knex on the host (outside docker-compose).
DATABASE_URL=postgres://payment:change-me@localhost:5432/payment_store

# Payment Store adapter: postgres (needs DATABASE_URL) or memory (no database, data is lost on restart).
# docker-compose forces postgres.
PAYMENT_STORE=memory

# Database pool and timeouts (6.4). Leave them unset to use the APP_ENV defaults
# (see docs/operations/database.md); 0 turns a Postgres timeout off.
# DB_POOL_MIN=0
# DB_POOL_MAX=5
# DB_ACQUIRE_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# DB_MIGRATION_LOCK_TIMEOUT_MS=10000

# HS256 secret shared with the Auth Service to validate its JWTs. `npm run token` signs dev tokens with it.
JWT_SECRET=change-me-dev-jwt-secret
